<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="350dp"
    android:layout_height="400dp"
    android:orientation="vertical"
    android:layout_gravity="center"
    android:background="@android:color/white"
    tools:context=".activity.MonthWiseIncentiveFeddbackActivity">
    <LinearLayout
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        android:background="@color/colorPrimary">
        <ImageView
            android:visibility="gone"
            android:id="@+id/imgBack"
            android:layout_gravity="center"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/ic_arrow_back"></ImageView>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Incentive Feedback"
            android:layout_gravity="center"
            android:paddingLeft="10dp"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:fontFamily="sans-serif"
            android:textStyle="bold"></TextView>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="right"
            android:paddingRight="10dp">
            <LinearLayout
                android:id="@+id/llSearch"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginRight="10dp">
                <ImageView
                    android:visibility="gone"
                    android:layout_gravity="center"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/search"></ImageView>
            </LinearLayout>
            <ImageView
                android:visibility="gone"
                android:id="@+id/imgHome"
                android:layout_gravity="center"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/ic_home_"></ImageView>
        </LinearLayout>


    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <LinearLayout
                android:visibility="gone"
                android:id="@+id/llMain"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="20dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color1"
                    android:textSize="14sp"
                    android:text="Enter your 10 digits Mbile Number:"></TextView>
                <EditText
                    android:maxLength="10"
                    android:inputType="phone"
                    android:id="@+id/etMob"
                    android:textSize="14sp"
                    android:textColor="@color/color1"
                    android:padding="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/lldesign"></EditText>
                <TextView
                    android:id="@+id/tvMonth"
                    android:layout_marginTop="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color1"
                    android:textSize="14sp"
                    android:text="Have you qualified incentive in June month?"></TextView>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">
                    <LinearLayout
                        android:id="@+id/llYes"
                        android:gravity="center"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:background="@drawable/lldesign">
                        <ImageView
                            android:visibility="gone"
                            android:id="@+id/imgYes"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/tickicon"></ImageView>
                    </LinearLayout>
                    <TextView
                        android:layout_marginLeft="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/color1"
                        android:textSize="14sp"
                        android:text="Yes"></TextView>
                    <LinearLayout
                        android:layout_marginLeft="10dp"
                        android:id="@+id/llNo"
                        android:gravity="center"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:background="@drawable/lldesign">
                        <ImageView
                            android:visibility="gone"
                            android:id="@+id/imgNo"
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:src="@drawable/tickicon"></ImageView>
                    </LinearLayout>
                    <TextView
                        android:layout_marginLeft="5dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/color1"
                        android:textSize="14sp"
                        android:text="No"></TextView>

                </LinearLayout>
                <LinearLayout
                    android:visibility="gone"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:id="@+id/llYesAns">
                    <TextView
                        android:layout_marginTop="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/color1"
                        android:textSize="14sp"
                        android:text="Received Amount:"></TextView>
                    <EditText
                        android:inputType="number"
                        android:id="@+id/etAmt"
                        android:textSize="14sp"
                        android:textColor="@color/color1"
                        android:padding="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/lldesign"></EditText>
                    <LinearLayout
                        android:layout_marginTop="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/color1"
                            android:textSize="14sp"
                            android:text="Received On:"></TextView>
                        <ImageView
                            android:id="@+id/imgCalendar"
                            android:layout_marginLeft="5dp"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@drawable/calendar"></ImageView>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvdate"
                        android:layout_marginTop="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/color1"
                        android:textSize="14sp"
                        ></TextView>

                    <TextView
                        android:layout_marginTop="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/color1"
                        android:textSize="14sp"
                        android:text="Please select medium of payment"></TextView>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:background="@drawable/lldesign">
                    <Spinner
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:id="@+id/spMode"></Spinner>
                </LinearLayout>
                </LinearLayout>




                <TextView
                    android:layout_marginTop="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/color1"
                    android:textSize="14sp"
                    android:text="Any feedback on product and process:"></TextView>
                <EditText
                    android:gravity="top"
                    android:maxLength="250"
                    android:id="@+id/etFeedback"
                    android:textSize="14sp"
                    android:textColor="@color/color1"
                    android:padding="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/lldesign"></EditText>

                <Button

                    android:id="@+id/btnSubmit"
                    android:layout_marginTop="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@android:color/black"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:text="Submit"></Button>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>